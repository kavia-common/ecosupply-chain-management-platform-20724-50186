# PUBLIC vars example for configuration
# The app will read these via process.env at build time when present.
# Do not commit your .env with secrets to source control.

# Base site URL used for links and auth redirect
REACT_APP_SITE_URL=http://localhost:3000

# API base URL (dummy services fallback to local mocks when not set)
REACT_APP_API_BASE_URL=http://localhost:4000

# Feature flags (true/false)
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_EDU_RESOURCES=true
REACT_APP_ENABLE_TIERED_AUDIT=true
